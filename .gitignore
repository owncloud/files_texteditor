/build/
/l10n/.transifexrc
.php_cs.cache
.php-cs-fixer.cache

# Composer. Anchored to the project root: an unanchored `vendor/` also silences
# js/vendor/, where the vendored Ace build lives. That ignored the whole
# directory, so the /js/vendor/ace/... rules below could never take effect (git
# does not descend into an ignored directory) and new files there needed
# `git add -f`.
/vendor/
vendor-bin/**/vendor
vendor-bin/**/composer.lock

# Mac OS
.DS_Store

# Tests - auto-generated files
/tests/acceptance/output
/tests/output
.phpunit.result.cache

# Remove unnecessary workers
/js/vendor/ace/src-noconflict/worker-*
# Remove unnecessary themes, but keep the one we use!
/js/vendor/ace/src-noconflict/theme-*
!/js/vendor/ace/src-noconflict/theme-clouds.js
# Remove unnecessary extensions
/js/vendor/ace/src-noconflict/ext-*
!/js/vendor/ace/src-noconflict/ext-modelist.js
!/js/vendor/ace/src-noconflict/ext-searchbox.js

.phpunit.result.cache

# SonarCloud scanner
.scannerwork

# Generated from .drone.star
.drone.yml

# IDE Cache
.idea/